# ---------------------------------------------------------------------------
# Milky backend — OmniMeeting AI Video Security (AIVS) + Video Camera Mgmt (VCM)
# ---------------------------------------------------------------------------

PORT=3000

# --- Auth -------------------------------------------------------------------
# Set a JWT secret and/or a static API key. If neither is set the server refuses
# to start unless ALLOW_ANONYMOUS=true (local development only).
JWT_SECRET=
API_KEY=
ALLOW_ANONYMOUS=true

# --- Anthropic (vision analysis) -------------------------------------------
# Required for real analysis. Without it the pipeline still ingests frames and
# reports motion, but every analysis is marked "unavailable".
ANTHROPIC_API_KEY=
AIVS_MODEL=claude-opus-5
# low | medium | high | xhigh | max
AIVS_EFFORT=medium
AIVS_MAX_TOKENS=2000

# --- External binaries ------------------------------------------------------
# Absolute paths, or leave empty to resolve from PATH.
FFMPEG_PATH=
FFPROBE_PATH=
YTDLP_PATH=

# --- Storage ----------------------------------------------------------------
DB_PATH=./milky.db
MEDIA_DIR=./media

# --- Ingest defaults (per-camera values override these) ---------------------
AIVS_FPS=1
AIVS_FRAME_WIDTH=768
AIVS_JPEG_QUALITY=4
AIVS_MOTION_THRESHOLD=0.012
AIVS_COOLDOWN_MS=15000
AIVS_HEARTBEAT_MS=300000
AIVS_FRAMES_PER_ANALYSIS=3
AIVS_MAX_CONCURRENT_ANALYSES=3

# --- YouTube ----------------------------------------------------------------
# Resolved direct stream URLs are cached this long before re-resolving.
YTDLP_CACHE_MS=1800000
