# primarni backend umesto /api/analyze.
# VITE_OMNI_FUNCTION_URL=https://<projekat>.supabase.co/functions/v1/analyze-hazards

# Secret za Supabase edge funkciju (postaviti u Supabase dashboardu, isti kao u omni repou):
# OPENROUTER_API_KEY=sk-or-...
