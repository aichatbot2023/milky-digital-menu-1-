# Backend (Vercel / Netlify functions) — NIKAD ne stavljati u klijentski kod
ANTHROPIC_API_KEY=sk-ant-...

# Opciono: model za analizu (podrazumevano claude-opus-4-8)
SAFENEST_MODEL=claude-opus-4-8

# OMNI kamera AI API (Supabase edge funkcija analyze-hazards, OpenRouter vision)
